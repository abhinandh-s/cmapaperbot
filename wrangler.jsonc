{
  "name": "cma-paper-bot",
  "main": "src/main.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "KV" }],
  "rules": [{ "type": "Data", "globs": ["**/*.jpeg", "**/*.jpg"], "fallthrough": true }]
}